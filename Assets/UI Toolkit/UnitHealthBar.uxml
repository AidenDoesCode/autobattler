<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root-anchor" style="flex-grow: 1; align-items: center; justify-content: center; overflow: visible;">
        
        <!-- Stacked container: Stars & Floating Popups sit on top of Health Bar -->
        <ui:VisualElement style="align-items: center; justify-content: flex-end; overflow: visible;">
            
            <!-- Container where damage/heal labels spawn and float -->
            <ui:VisualElement name="popup-container" style="position: absolute; bottom: 24px; width: 120px; height: 60px; overflow: visible;" />

            <!-- Overhead Star Badge -->
            <ui:Label name="star-badge-label" text="★" style="font-size: 13px; -unity-font-style: bold; color: rgb(189, 195, 199); margin-bottom: 2px; -unity-text-align: middle-center; display: none;" />

            <!-- Health Bar -->
            <ui:VisualElement name="bar-background" style="width: 80px; height: 10px; background-color: rgba(0, 0, 0, 0.75); border-radius: 3px; padding: 1px;">
                <ui:VisualElement name="bar-fill" style="width: 100%; height: 100%; background-color: rgb(46, 204, 113); border-radius: 2px;" />
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>