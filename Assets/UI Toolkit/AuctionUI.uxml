<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="auction-root" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: center; align-items: center; background-color: rgba(10, 10, 15, 0.85); display: flex;">
        
        <ui:VisualElement name="auction-window" style="width: 500px; padding: 24px; background-color: rgb(25, 27, 34); border-width: 2px; border-color: rgb(255, 215, 0); border-radius: 8px; align-items: center;">
            
            <!-- Header & Timer -->
            <ui:Label text="BLIND AUCTION" style="font-size: 26px; -unity-font-style: bold; color: rgb(255, 215, 0); margin-bottom: 4px;" />
            <ui:Label name="auction-timer-label" text="Time Remaining: 10s" style="font-size: 16px; color: rgb(255, 100, 100); margin-bottom: 16px;" />

            <!-- Prize Card Spotlight (Clickable) -->
            <ui:VisualElement name="prize-card" picking-mode="Position" style="width: 230px; height: 145px; background-color: rgb(35, 39, 45); border-width: 2px; border-color: rgb(150, 120, 255); border-radius: 8px; justify-content: center; align-items: center; margin-bottom: 20px;">
                <ui:Label name="prize-name" picking-mode="Ignore" text="Champion Name" style="font-size: 19px; -unity-font-style: bold; color: rgb(255, 255, 255);" />
                <ui:Label name="prize-archetype" picking-mode="Ignore" text="Melee | Tier 3" style="font-size: 14px; color: rgb(180, 180, 200); margin-top: 4px;" />
                <ui:Label text="(Click or Right-Click to Inspect)" picking-mode="Ignore" style="font-size: 11px; color: rgb(241, 196, 15); margin-top: 8px;" />
            </ui:VisualElement>

            <!-- Bidding Controls -->
            <ui:VisualElement name="bidding-controls" style="width: 100%; align-items: center;">
                <ui:Label text="Place Your Secret Bid" style="font-size: 15px; color: rgb(200, 200, 200); margin-bottom: 8px;" />
                
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 16px;">
                    <ui:Button name="bid-minus-btn" text="-1g" style="width: 50px; height: 35px; background-color: rgb(192, 57, 43); color: white; -unity-font-style: bold; border-radius: 4px;" />
                    <ui:Label name="player-bid-label" text="0g" style="width: 100px; -unity-text-align: middle-center; font-size: 22px; -unity-font-style: bold; color: rgb(255, 215, 0);" />
                    <ui:Button name="bid-plus-btn" text="+1g" style="width: 50px; height: 35px; background-color: rgb(39, 174, 96); color: white; -unity-font-style: bold; border-radius: 4px;" />
                    <ui:Button name="bid-plus5-btn" text="+5g" style="width: 50px; height: 35px; margin-left: 6px; background-color: rgb(41, 128, 185); color: white; -unity-font-style: bold; border-radius: 4px;" />
                </ui:VisualElement>

                <ui:Button name="lock-bid-btn" text="Lock In Bid" style="width: 180px; height: 40px; background-color: rgb(211, 84, 0); color: white; -unity-font-style: bold; border-radius: 4px;" />
            </ui:VisualElement>

            <!-- Reveal Section -->
            <ui:VisualElement name="reveal-section" style="width: 100%; align-items: center; display: none;">
                <ui:Label name="reveal-winner-label" text="Player Won!" style="font-size: 22px; -unity-font-style: bold; color: rgb(46, 204, 113); margin-bottom: 8px;" />
                <ui:Label name="reveal-details-label" text="Player: 12g  |  Opponent: 8g" style="font-size: 16px; color: rgb(200, 200, 200);" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- AUCTION PRIZE INSPECTION MODAL (Renders on top of the auction window) -->
        <ui:VisualElement name="auction-inspect-modal" picking-mode="Position" style="position: absolute; width: 280px; background-color: rgba(18, 20, 26, 0.98); border-width: 2px; border-color: rgb(241, 196, 15); border-radius: 10px; padding: 16px; display: none;">
            <ui:VisualElement picking-mode="Ignore" style="flex-direction: row; justify-content: space-between; align-items: flex-start; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.2); padding-bottom: 8px; margin-bottom: 12px;">
                <ui:VisualElement picking-mode="Ignore" style="flex-direction: column; flex-grow: 1; margin-right: 8px;">
                    <ui:Label name="auction-inspect-title" text="Unit Name" style="font-size: 19px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-bottom: 2px; white-space: normal;" />
                    <ui:Label name="auction-inspect-subtitle" text="★ • Melee (3g Cost)" style="font-size: 14px; -unity-font-style: bold; color: rgb(241, 196, 15); white-space: normal;" />
                </ui:VisualElement>
                <ui:Button name="auction-inspect-close-btn" text="✕" style="width: 28px; height: 28px; background-color: transparent; border-width: 0; color: rgb(189, 195, 199); font-size: 16px; -unity-font-style: bold; flex-shrink: 0;" />
            </ui:VisualElement>

            <ui:VisualElement picking-mode="Ignore" style="flex-direction: column; margin-bottom: 12px;">
                <ui:Label name="auction-inspect-hp" text="Base HP: 500" style="font-size: 15px; -unity-font-style: bold; color: rgb(46, 204, 113); margin-bottom: 5px; white-space: normal;" />
                <ui:Label name="auction-inspect-ad" text="Base Attack: 50" style="font-size: 15px; -unity-font-style: bold; color: rgb(231, 76, 60); margin-bottom: 5px; white-space: normal;" />
                <ui:Label name="auction-inspect-extra" text="Range: 1.0  |  Speed: 1.0" style="font-size: 13px; color: rgb(52, 152, 219); margin-bottom: 2px; white-space: normal;" />
            </ui:VisualElement>

            <ui:VisualElement picking-mode="Ignore" style="border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.2); padding-top: 10px;">
                <ui:Label text="AUCTION LOT DETAILS" style="font-size: 12px; -unity-font-style: bold; color: rgb(200, 205, 215); margin-bottom: 4px;" />
                <ui:Label text="Spawns directly to your bench if won." style="font-size: 13px; color: rgb(160, 175, 190); white-space: normal;" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>